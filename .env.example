APP_NAME=AI Receptionist
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_receptionist
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MAX_TOKENS=200
SHORT_MEMORY_MESSAGES=6
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
VOICE_ENABLED=true
STT_PROVIDER=groq_whisper
WHISPER_MODEL=base
VAD_AGGRESSIVENESS=2
VAD_MIN_RMS=100.0
VAD_SILENCE_DURATION_MS=350
VAD_PRE_BUFFER_MS=200
VAD_POST_BUFFER_MS=150
CHUNK_DURATION_MS=500
TTS_VOICE=en-US-JennyNeural
SILENCE_TIMEOUT_SEC=30

# Vonage Configuration
VONAGE_API_KEY=your_vonage_api_key_here
VONAGE_API_SECRET=your_vonage_api_secret_here
VONAGE_FROM_NUMBER=your_vonage_from_number_here

# Email Configuration
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_USE_TLS=true
SENDGRID_API_KEY=your_sendgrid_api_key_here
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=noreply@logicpulse.com

# SMS Configuration
SMS_RATE_LIMIT_COUNT=5
SMS_RATE_LIMIT_WINDOW_SECONDS=300
